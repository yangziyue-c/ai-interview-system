# ===================== 数据库 =====================
# 默认 SQLite：零配置，双击 start.bat 即可运行（开发/演示推荐）
DATABASE_URL=sqlite+aiosqlite:///./interview.db
# 切换 MySQL（正式环境，需先在 MySQL 中建库）：
#   CREATE DATABASE interview_db DEFAULT CHARACTER SET utf8mb4;
# DATABASE_URL=mysql+aiomysql://root:你的密码@127.0.0.1:3306/interview_db

# ===================== Redis =====================
# 留空则自动降级为进程内缓存（不影响功能，适合演示）
# REDIS_URL=redis://127.0.0.1:6379/0

# ===================== JWT 鉴权 =====================
# 上线前务必修改为随机长字符串！
JWT_SECRET_KEY=change-this-secret-key-before-production
JWT_EXPIRE_MINUTES=1440

# ===================== 面试规则 =====================
# 最大追问轮数：开场题之后 AI 最多追问几轮（总题数 = 1 + 该值）
MAX_FOLLOW_UP_ROUNDS=6

# ===================== P2/P3 适配器 =====================
# 留空 = 使用内置 Mock 数据；填入 HTTP 地址后自动调用真实服务
# 调用超时（秒），超过该时长自动降级为 Mock 兜底（评估接口单独 30 秒预算）
AI_INTERVIEWER_URL=
# P3 评估服务由 start.py 自动拉起（backend/evaluator，端口 8002），保持该默认值即可
AI_EVALUATOR_URL=http://127.0.0.1:8002
ADAPTER_TIMEOUT_SECONDS=15

# ===================== 大模型直连（可选，P2 服务未就绪时临时用）=====================
# 只要填了 LLM_API_KEY，AI 追问就会调用真实大模型（OpenAI 兼容接口）
# 优先级：AI_INTERVIEWER_URL > LLM_API_KEY > 内置 Mock
# 示例（DeepSeek / 通义 / Kimi 等均兼容）：
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# LLM_MODEL=deepseek-chat

# ===================== 其他 =====================
DEBUG=true

# 服务端口（与 start.bat 保持一致，内网穿透本地端口填同一个值）
PORT=8001
