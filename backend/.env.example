# ===================== 数据库 =====================
# 默认 SQLite：零配置，双击 start.bat 即可运行（开发/演示推荐）
DATABASE_URL=sqlite+aiosqlite:///./interview.db
# 切换 MySQL（正式环境，需先在 MySQL 中建库）：
#   CREATE DATABASE interview_db DEFAULT CHARACTER SET utf8mb4;
# DATABASE_URL=mysql+aiomysql://root:你的密码@127.0.0.1:3306/interview_db

# ===================== Redis =====================
# 留空则自动降级为进程内缓存（不影响功能，适合演示）
# REDIS_URL=redis://127.0.0.1:6379/0

# ===================== JWT 鉴权 =====================
# 上线前务必修改为随机长字符串！
JWT_SECRET_KEY=change-this-secret-key-before-production
JWT_EXPIRE_MINUTES=1440

# ===================== 面试规则 =====================
# 最大追问轮数：开场题之后 AI 最多追问几轮（总题数 = 1 + 该值）
MAX_FOLLOW_UP_ROUNDS=6

# ===================== 上传 =====================
# 录音上限（MB）；头像与简历另有独立上限
# （MAX_AVATAR_SIZE_MB=2 / MAX_RESUME_SIZE_MB=10），见 app/config.py
MAX_UPLOAD_SIZE_MB=20
MAX_RESUME_SIZE_MB=10

# ===================== P2/P3 适配器 =====================
# 面试官出题数据源优先级：题库策略（questions 表，backend/interviewer/）> AI_INTERVIEWER_URL > LLM_API_KEY > 内置 Mock
# 题库策略为最高优先级：该岗位在 questions 表有题时走题库，外部服务/大模型仅在题库未命中（岗位无题等）时生效
# 调用超时（秒），超过该时长自动降级（评估接口单独 30 秒预算）
AI_INTERVIEWER_URL=
# P3 评估服务由 start.py 自动拉起（backend/evaluator，端口 8002），保持该默认值即可
AI_EVALUATOR_URL=http://127.0.0.1:8002
ADAPTER_TIMEOUT_SECONDS=15

# ===================== 大模型直连（可选，题库未命中时的兜底源）=====================
# 填了 LLM_API_KEY 后，仅当题库策略未命中时 AI 追问才会调用真实大模型（OpenAI 兼容接口）
# 优先级：题库策略 > AI_INTERVIEWER_URL > LLM_API_KEY > 内置 Mock
# 示例（DeepSeek / 通义 / Kimi 等均兼容）：
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# LLM_MODEL=deepseek-chat

# ===================== AI 对话层引擎（可选，P5 交付的 A11）=====================
# 置空 = 关闭：面试走原链路（题库策略出题 + P3 评估，7 轮制）
# 设为 a11 = 启用：出题 / 追问 / 五维评分全部委托独立服务（backend/dialogue_layer/，
#   start.py 会自动拉起，端口 8005），本后端只做镜像落库（10 题制）
# ⚠️ 启用后若引擎未就绪，面试接口会明确返回 503，**不会静默回落原链路**——
#    分数悄悄换一套口径而看不出来，是最难查的一类问题。要回原链路就置空本项。
# 引擎需要三家的密钥（键名与引擎侧一致，start.py 读出来后经环境变量注入子进程）：
#   · LLM_API_KEY          DeepSeek，主观评分；同时供主后端的 LLM 直连兜底
#   · SILICONFLOW_API_KEY  硅基流动，在线 reranker 与 embedding（KB 检索用）
#   · DASHSCOPE_API_KEY    DashScope，客观题评分 / 面试官朗读 / 在线语音转写
# 示例（真实密钥由 P5 的 Private 交接包提供，只落本文件，不要外发或提交）：
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxx
# DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
DIALOGUE_ENGINE=
# 引擎地址（start.py 拉起的默认端口 8005；正式服务由 P5 运行时，这里改为对方地址）
DIALOGUE_ENGINE_URL=http://localhost:8005
# 引擎一场的题数（A11 固定 3/5/2 共 10 题），用于前端渲染「第 N / 共几题」胶囊
DIALOGUE_ENGINE_TOTAL_QUESTIONS=10
# 引擎的轻量 / 全功能档：默认轻量（RAG 与 KB 关，内存友好）
# 设 1 开全功能：启用 RAG 与知识库检索，代价是首次交卷时加载本地 bge-m3（约 2.2GB 常驻）
DIALOGUE_FULL=

# ===================== 报告分享 =====================
# 分享链接有效期（天）：过期后凭分享码访问返回 404，报告本身不受影响
SHARE_EXPIRE_DAYS=7

# ===================== 其他 =====================
DEBUG=true

# 服务端口（与 start.bat 保持一致，内网穿透本地端口填同一个值）
PORT=8001
