# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 环境配置（含密钥，不入库）
.env

# 需求文档（内部资料，不入库）
a.md

# 数据库文件
*.db
*.sqlite3
# 数据库备份（重建/迁移前的手工备份，不入库）
*.db.bak*
# SQLite WAL 模式伴随文件（运行时产物）
*.db-shm
*.db-wal

# 上传的音频（不入库，目录保留）
backend/uploads/*
!backend/uploads/.gitkeep

# 简历原件私有目录（含姓名/学号/联系方式等个人信息，绝不入库）
# 只增不减地接收用户上传的简历，一旦提交就是隐私事故
backend/private/

# 测试临时目录（用例的目录隔离落点，会话结束自动清理）
backend/.test_tmp/

# 前端构建产物（由各成员本地构建，不入库）
frontend/node_modules/
frontend/dist/

# AI 对话层（A11）模型缓存：bge-reranker-v2-m3 约 2.14GB，首次运行自动下载
backend/.hf_cache/

# AI 对话层 RAG 旁路数据（约 224MB，A11_RAG=0 时不加载，可由 P2 的构建产物重取）
backend/dialogue_layer/数据/rag/

# AI 对话层运行时日志
backend/dialogue_layer/logs/

# RAG 向量库（674MB，可由 rag/数据/*-rag-v2.jsonl 重建，不入库）
# 目录名必须纯 ASCII：chromadb 打不开含非 ASCII 的绝对路径（详见 rag/代码/README.md）
backend/rag/vector_db/
# RAG 检索中间数据（约 70MB，仅重建向量库时需要；主库 *-v5.json 共 16MB 正常入库）
backend/rag/数据/*-rag-v2.jsonl

# 测试与缓存
.pytest_cache/
.coverage
htmlcov/

# IDE
.idea/
.vscode/
*.swp
.DS_Store
.claude/settings.local.json
